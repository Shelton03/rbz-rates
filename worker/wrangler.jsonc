{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rbz-rates",
  "account_id": "0621797b9cca69f4b4449f2e5759e5ce",
  "main": "src/main.py",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["python_workers"],
  // The scraper's JSON output, deployed alongside the Worker and read through env.ASSETS.
  // run_worker_first: every request goes to the API; files are only reachable through it.
  "assets": {
    "directory": "../data",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Workers Logs (free plan): request logs + CPU time in the dashboard
  "observability": { "enabled": true },
  // Accounts, API keys and usage counters. Create once with `npx wrangler d1 create rbz-rates`
  // and paste the database_id it prints. Schema: migrations/ (applied by the deploy workflow).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rbz-rates",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (not in this file): ADMIN_SECRET, ANON_SALT. Locally they go in .dev.vars.
  "vars": { "SITE_URL": "https://rbz-rates.vercel.app" }
}
