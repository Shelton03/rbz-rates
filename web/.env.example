# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# The Cloudflare Worker API
RBZ_API_URL=https://rbz-rates.sheltonmutambirwa.workers.dev
# Same value as the Worker's ADMIN_SECRET (lets this site manage accounts and keys, and lets the
# deploy workflow purge this site's cached API data via POST /api/revalidate)
RBZ_ADMIN_SECRET=
# Optional: an API key for the site's own server-side requests (the landing page rates)
RBZ_API_KEY=

# Auth (NextAuth.js) - a GitHub OAuth App: github.com/settings/developers
#   Homepage URL:  https://<your-site>.vercel.app
#   Callback URL:  https://<your-site>.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Random string: openssl rand -base64 32
NEXTAUTH_SECRET=
# Only needed outside Vercel, e.g. http://localhost:3000
NEXTAUTH_URL=

# Comma-separated GitHub user ids that can see /admin (site-wide usage). Yours: gh api user --jq .id
OWNER_GITHUB_IDS=

# Development only (ignored in production builds): pretend to be signed in as this GitHub id:login
DEV_FAKE_USER=
